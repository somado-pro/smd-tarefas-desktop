{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Somado Tarefas",
  "version": "0.3.2",
  "identifier": "br.com.somado.tarefas",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": { "encarte-pc/": "encarte-pc/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"] }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["somado-tarefas"] }
    },
    "updater": {
